@page "/sistemas"

@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IApiService _apiService
@inject HttpClient httpClient

@using Auth.Client.Dialogs;
@using System.Net.Http.Json

@if (_sistemas == null)
{
    <MudStack Spacing="2">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" />
    </MudStack>
} else 
{
    <MudStack Spacing="4">
        <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="2">
            <div>
                <MudText Typo="Typo.h5" HtmlTag="h1">Sistemas</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Aplicações protegidas, seus perfis (roles) e claims de permissão.</MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="NovoSistemaAsync">
                Novo sistema
            </MudButton>
        </MudStack>

        <MudTextField @bind-Value="_busca" Immediate="true" Placeholder="Buscar sistema por nome ou URL"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      aria-label="Buscar sistemas" />

        @if (!SistemasFiltrados.Any())
        {
            <MudPaper Outlined="true" Class="pa-8">
                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Outlined.Apps" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(_busca) ? "Nenhum sistema cadastrado" : "Nenhum sistema encontrado para a busca")</MudText>
                    @if (string.IsNullOrWhiteSpace(_busca))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NovoSistemaAsync">Criar primeiro sistema</MudButton>
                    }
                </MudStack>
            </MudPaper>
        }

        <MudExpansionPanels MultiExpansion="true">
            @foreach (var sistema in SistemasFiltrados)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudStack Row="true" Justify="Justify.SpaceBetween"
                                  AlignItems="AlignItems.Center" Wrap="Wrap.NoWrap" Style="width:100%; padding-right:8px;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Style="min-width:0">
                                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                                    @Initials(sistema.Name)
                                </MudAvatar>
                                <div style="min-width:0">
                                    <MudText Typo="Typo.subtitle1" Style="font-weight:500">@sistema.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="auth-mono" Style="word-break:break-all">@sistema.Url</MudText>
                                </div>
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudHidden Breakpoint="Breakpoint.Xs">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                        @sistema.Permissoes.Count role(s)
                                    </MudChip>
                                </MudHidden>
                                <MudTooltip Text="Editar sistema">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               aria-label="@($"Editar sistema {sistema.Name}")"
                                               OnClick="() => OpenSistemaDialog(sistema)" />
                                </MudTooltip>
                                <MudTooltip Text="Excluir sistema">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small" Color="Color.Error"
                                               aria-label="@($"Excluir sistema {sistema.Name}")"
                                               OnClick="() => RemoverSistema(sistema)" />
                                </MudTooltip>
                            </MudStack>
                        </MudStack>
                    </TitleContent>

                    <ChildContent>
                        <MudTabs Elevation="0" Rounded="false" PanelClass="pa-4"
                                 ApplyEffectsToContainer="true" Color="Color.Primary">

                            <MudTabPanel Text="Roles e Claims">
                                <MudStack Spacing="3">
                                    @foreach (var role in sistema.Permissoes)
                                    {
                                        <MudCard Outlined="true" Elevation="0">
                                            <MudCardHeader Style="padding:10px 14px; background:var(--mud-palette-background-grey)">
                                                <CardHeaderContent>
                                                    <MudText Typo="Typo.subtitle2">@role.Name</MudText>
                                                </CardHeaderContent>
                                                <CardHeaderActions>
                                                    <MudTooltip Text="Excluir role"><MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                   Size="Size.Small" Color="Color.Error"
                                                                   aria-label="Excluir role" OnClick="() => RemoverRole(sistema, role)" /></MudTooltip>
                                                </CardHeaderActions>
                                            </MudCardHeader>

                                            <MudCardContent Style="padding:12px 14px">
                                                @{
                                                    var claims = _claimsPorRole.GetValueOrDefault(role.Id, new());
                                                }
                                                <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">
                                                    Claims (@claims.Count)
                                                </MudText>

                                                <MudGrid Spacing="1">
                                                    @foreach (var claim in claims)
                                                    {
                                                        <MudItem>
                                                            <MudChip T="string"
                                                                     Size="Size.Small"
                                                                     Variant="Variant.Outlined"
                                                                     OnClose="() => RemoverClaim(role.Id, claim)"
                                                                     CloseIcon="@Icons.Material.Filled.Close"
                                                                     Class="auth-mono">
                                                                @claim.ClaimValue
                                                            </MudChip>
                                                        </MudItem>
                                                    }
                                                </MudGrid>

                                                <MudDivider Class="my-2" />

                                                @if (_roleComInputAberto == role.Id)
                                                {
                                                    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1">
                                                        <MudTextField @bind-Value="_novaClaimTexto"
                                                                      Placeholder="ex: AUTH:LER" HelperText="Padrão SISTEMA:ACAO"
                                                                      Variant="Variant.Outlined"
                                                                      Margin="Margin.Dense"
                                                                      Class="auth-mono" Style="min-width:200px"
                                                                      @onkeydown="(e) => OnClaimKeyDown(e, role.Id)"
                                                                      Immediate="true" />
                                                        <MudIconButton Icon="@Icons.Material.Filled.Check"
                                                                       Size="Size.Small" Color="Color.Success"
                                                                       aria-label="Confirmar claim" OnClick="() => ConfirmarClaim(role.Id)" />
                                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                                       Size="Size.Small"
                                                                       aria-label="Cancelar" OnClick="CancelarClaim" />
                                                    </MudStack>
                                                }
                                                else
                                                {
                                                    <MudButton Size="Size.Small"
                                                               Variant="Variant.Text"
                                                               StartIcon="@Icons.Material.Filled.Add"
                                                               OnClick="() => AbrirInputClaim(role.Id)">
                                                        Adicionar claim
                                                    </MudButton>
                                                }
                                            </MudCardContent>
                                        </MudCard>
                                    }

                                    <MudStack Row="true" Justify="Justify.FlexEnd">
                                        <MudButton Variant="Variant.Outlined"
                                                   StartIcon="@Icons.Material.Filled.Add"
                                                   Size="Size.Small"
                                                   OnClick="() => OpenRoleDialog(sistema, null)">
                                            Nova role
                                        </MudButton>
                                    </MudStack>
                                </MudStack>
                            </MudTabPanel>

                            <MudTabPanel Text="Usuários">
                                <MudStack Spacing="3">
                                    @{
                                        var usuariosSistema = _usuariosPorSistema.GetValueOrDefault(sistema.Id, new());
                                    }

                                    @if (usuariosSistema.Any())
                                    {
                                        @foreach (var usuario in usuariosSistema)
                                        {
                                            <MudPaper Outlined="true" Class="pa-3">
                                                <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="2">
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                                        <MudAvatar Color="Color.Secondary" Size="Size.Small">
                                                            @Initials(usuario.Nome)
                                                        </MudAvatar>
                                                        <div>
                                                            <MudText Typo="Typo.subtitle2">@usuario.Nome</MudText>
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@usuario.Email</MudText>
                                                        </div>
                                                    </MudStack>
                                                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                                        @foreach (var perm in usuario.Systems.SelectMany(s => s.Permissoes))
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                                                @perm.Name
                                                            </MudChip>
                                                        }
                                                    </MudStack>
                                                </MudStack>
                                            </MudPaper>
                                        }
                                    }
                                    else
                                    {
                                        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center"
                                                  Style="padding: 1.5rem; opacity: 0.6">
                                            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" />
                                            <MudText Typo="Typo.body2">Nenhum usuário vinculado a este sistema</MudText>
                                        </MudStack>
                                    }

                                    <MudDivider />

                                    @if (_sistemaComVinculoAberto == sistema.Id)
                                    {
                                        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudSelect T="string"
                                                       @bind-Value="_usuarioSelecionadoId"
                                                       Label="Usuário"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       Style="min-width: 220px; flex:1 1 220px;">
                                                @foreach (var u in _todosUsuarios)
                                                {
                                                    <MudSelectItem T="string" Value="@u.Id">
                                                        @u.Nome (@u.Email)
                                                    </MudSelectItem>
                                                }
                                            </MudSelect>

                                            <MudSelect T="string"
                                                       @bind-Value="_roleSelecionadaId"
                                                       Label="Role"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       Style="min-width: 160px; flex:1 1 160px;">
                                                @foreach (var r in sistema.Permissoes)
                                                {
                                                    <MudSelectItem T="string" Value="@r.Id">
                                                        @r.Name
                                                    </MudSelectItem>
                                                }
                                            </MudSelect>

                                            <MudIconButton Icon="@Icons.Material.Filled.Check"
                                                           Size="Size.Small" Color="Color.Success"
                                                           aria-label="Confirmar vínculo" OnClick="() => ConfirmarVinculoUsuarioAsync(sistema)" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                           Size="Size.Small"
                                                           aria-label="Cancelar vínculo" OnClick="CancelarVinculoUsuario" />
                                        </MudStack>
                                    }
                                    else
                                    {
                                        <MudStack Row="true" Justify="Justify.FlexEnd">
                                            <MudButton Variant="Variant.Outlined"
                                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                                       Size="Size.Small"
                                                       Disabled="@(!sistema.Permissoes.Any())"
                                                       OnClick="() => AbrirVinculoUsuarioAsync(sistema.Id)">
                                                Vincular usuário
                                            </MudButton>
                                        </MudStack>
                                    }
                                </MudStack>
                            </MudTabPanel>

                        </MudTabs>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudStack>
}

@code {
    private List<SystemViewModel> _sistemas;
    private string _busca;

    private IEnumerable<SystemViewModel> SistemasFiltrados =>
        (_sistemas ?? new()).Where(s =>
            string.IsNullOrWhiteSpace(_busca)
            || (s.Name?.Contains(_busca, StringComparison.OrdinalIgnoreCase) ?? false)
            || (s.Url?.Contains(_busca, StringComparison.OrdinalIgnoreCase) ?? false));
    private Dictionary<string, List<ApplicationClaimViewModel>> _claimsPorRole = new();
    private Dictionary<string, List<AuthUserViewModel>> _usuariosPorSistema = new();
    private List<AuthUserViewModel> _todosUsuarios = new();

    private string _roleComInputAberto;
    private string _novaClaimTexto = string.Empty;

    private string _sistemaComVinculoAberto;
    private string _usuarioSelecionadoId;
    private string _roleSelecionadaId;

    // ── Lifecycle ────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        var response = await _apiService.GetAsync<List<SystemViewModel>>("api/sistema");
        if (!response.Success || response.Data is null)
        {
            _sistemas = new();
            MostrarErros(response.Errors);
            return;
        }

        _sistemas = response.Data;
        foreach (var s in _sistemas)
        {
            foreach (var role in s.Permissoes)
                _claimsPorRole[role.Id] = role.Claims;

            await CarregarUsuariosDoSistemaAsync(s.Id);
        }
    }

    private async Task CarregarUsuariosDoSistemaAsync(string sistemaId)
    {
        var res = await _apiService.GetAsync<List<AuthUserViewModel>>($"api/sistema/{sistemaId}/usuarios");
        _usuariosPorSistema[sistemaId] = res.Success && res.Data is not null ? res.Data : new();
    }
    #region claims
    private void AbrirInputClaim(string roleId)
    {
        _roleComInputAberto = roleId;
        _novaClaimTexto = "";
    }

    private void CancelarClaim()
    {
        _roleComInputAberto = null;
        _novaClaimTexto = "";
    }

    private async void ConfirmarClaim(string roleId)
    {
        var claim = new ApplicationClaimViewModel(roleId, _novaClaimTexto.Trim().ToUpper());
        if (string.IsNullOrWhiteSpace(claim.ClaimValue)) { CancelarClaim(); return; }

        var sucesso = await SalvaNovaClaim(claim);

        if (!_claimsPorRole.ContainsKey(roleId))
            _claimsPorRole[roleId] = new();

        if (!_claimsPorRole[roleId].Contains(claim) && sucesso)
            _claimsPorRole[roleId].Add(claim);

        CancelarClaim();
    }

    private async Task<bool> SalvaNovaClaim(ApplicationClaimViewModel claim)
    {
        var response = await _apiService.PostAsync<ApplicationClaimViewModel, bool>("api/sistema/claim", claim);
        if(!response.Success)
        {
            MostrarErros(response.Errors);
            return response.Success;
        }
        Snackbar.Add("Claim salva com sucesso!", Severity.Success);
        return true;
    }

    private async Task OnClaimKeyDown(KeyboardEventArgs e, string roleId)
    {
        if (e.Key == "Enter") ConfirmarClaim(roleId);
        if (e.Key == "Escape") CancelarClaim();
        await Task.CompletedTask;
    }

    private async void RemoverClaim(string roleId, ApplicationClaimViewModel claim)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
                title: "Confirmar exclusão",
                markupMessage: (MarkupString)$"Deseja excluir a claim <b>{claim.ClaimValue}</b> permanentemente?",
                yesText: "Excluir",
                noText: "Cancelar");

        if (confirm is not null && confirm == true)
        {
            var response = await _apiService.DeleteAsync($"api/sistema/claim/excluir/{roleId}/{claim.ClaimValue}");
            if (response.Success && _claimsPorRole.TryGetValue(roleId, out var lista))
            {
                Snackbar.Add("Claim Excluida com sucesso!", Severity.Success);
                lista.Remove(claim);
                StateHasChanged();
                return;
            }

            MostrarErros(response.Errors);
        }
    }

    #endregion

    #region Roles

    private async Task OpenRoleDialog(SystemViewModel sistema, ApplicationRoleViewModel? role)
    {
        var parameters = new DialogParameters
        {
            ["Sistema"] = sistema
        };
        var dialog = await DialogService.ShowAsync<CreateRoleDialog>("Nova role", parameters);

        var result = await dialog.Result;
        if (!result.Canceled && result.Data is ApplicationRoleViewModel r)
        {
            if (!sistema.Permissoes.Any(x => x.Id == r.Id))
            {
                sistema.Permissoes.Add(r);
                _claimsPorRole[r.Id] = new();
            }
            StateHasChanged();
        }
    }

    private async Task RemoverRole(SystemViewModel sistema, ApplicationRoleViewModel role)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
                title: "Confirmar exclusão",
                markupMessage: (MarkupString)$"Deseja excluir o perfil <b>{role.Name}</b> permanentemente?",
                yesText: "Excluir",
                noText: "Cancelar");

        if (confirm is not null && confirm == true)
        {
            var response = await _apiService.DeleteAsync($"api/sistema/roles/remover/{role.Id}");
            if (response.Success && sistema.Permissoes.Contains(role))
            {
                Snackbar.Add("Perfil excluido com sucesso!", Severity.Success);
                sistema.Permissoes.Remove(role);
                _claimsPorRole.Remove(role.Id);
                StateHasChanged();
                return;
            }

            MostrarErros(response.Errors);
        }
    }
    #endregion

    #region Systems
    private async Task NovoSistemaAsync()
    {
        var options = new DialogOptions
        {
            FullWidth = true,
            MaxWidth = MaxWidth.Small,
            CloseOnEscapeKey = true
        };
        var dialog = await DialogService.ShowAsync<CreateSystemDialog>("", options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is SystemViewModel novoSistema)
        {
            _sistemas.Add(novoSistema);
            _usuariosPorSistema[novoSistema.Id] = new();
            StateHasChanged();
        }
    }

    private async Task RemoverSistema(SystemViewModel sys)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            title: "Confirmar exclusão",
            markupMessage: (MarkupString)$"Deseja excluir o sistema <b>{sys.Name}</b> permanentemente?",
            yesText: "Excluir",
            noText: "Cancelar");

        if (confirm == true)
        {
            var response = await _apiService.DeleteAsync($"api/sistema/{sys.Id}");
            if (response.Success)
            {
                Snackbar.Add("Sistema excluído com sucesso!", Severity.Success);
                _sistemas.Remove(sys);
                _usuariosPorSistema.Remove(sys.Id);
                StateHasChanged();
                return;
            }

            MostrarErros(response.Errors);
        }
    }

    private async Task OpenSistemaDialog(SystemViewModel sistema)
    {
        var options = new DialogOptions
        {
            FullWidth = true,
            MaxWidth = MaxWidth.Small,
            CloseOnEscapeKey = true
        };
        var copia = new SystemViewModel
        {
            Id = sistema.Id,
            Name = sistema.Name,
            Url = sistema.Url,
            Permissoes = sistema.Permissoes
        };
        var parameters = new DialogParameters
        {
            ["Model"] = copia,
            ["IsEditing"] = true
        };
        var dialog = await DialogService.ShowAsync<CreateSystemDialog>("Editar sistema", parameters, options);

        var result = await dialog.Result;
        if (!result.Canceled && result.Data is SystemViewModel s)
        {
            sistema.Name = s.Name;
            sistema.Url = s.Url;
            StateHasChanged();
        }
    }

    private async Task AbrirVinculoUsuarioAsync(string sistemaId)
    {
        if (!_todosUsuarios.Any())
        {
            var res = await _apiService.GetAsync<List<AuthUserViewModel>>("api/auth/listar-usuarios");
            if (res.Success && res.Data is not null)
                _todosUsuarios = res.Data;
            else
                MostrarErros(res.Errors);
        }

        _sistemaComVinculoAberto = sistemaId;
        _usuarioSelecionadoId = string.Empty;
        _roleSelecionadaId = string.Empty;
    }

    private void CancelarVinculoUsuario()
    {
        _sistemaComVinculoAberto = null;
        _usuarioSelecionadoId = string.Empty;
        _roleSelecionadaId = string.Empty;
    }

    private async Task ConfirmarVinculoUsuarioAsync(SystemViewModel sistema)
    {
        if (string.IsNullOrWhiteSpace(_usuarioSelecionadoId) || string.IsNullOrWhiteSpace(_roleSelecionadaId))
        {
            Snackbar.Add("Selecione o usuário e a role para vincular.", Severity.Warning);
            return;
        }

        var response = await _apiService.PostAsync<object, bool>(
            $"api/sistema/{sistema.Id}/usuarios/{_usuarioSelecionadoId}/roles/{_roleSelecionadaId}",
            new { });

        if (!response.Success)
        {
            MostrarErros(response.Errors);
            return;
        }

        Snackbar.Add("Usuário vinculado ao sistema com sucesso!", Severity.Success);
        await CarregarUsuariosDoSistemaAsync(sistema.Id);
        CancelarVinculoUsuario();
        StateHasChanged();
    }
    #endregion

    // ── Helpers ──────────────────────────────────────────────────────────────
    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : name[..Math.Min(2, name.Length)].ToUpper();
    }

    private async Task ImprimeErrosRetornoHttp(HttpResponseMessage response)
    {
        var error = await response.Content.ReadFromJsonAsync<ResponseError<string[]>>();
        foreach (var errorMessage in error.Errors)
            Snackbar.Add(errorMessage, Severity.Error);
    }

    private void MostrarErros(string[] erros)
    {
        foreach (var errorMessage in erros)
            Snackbar.Add(errorMessage, Severity.Error);
    }
}
