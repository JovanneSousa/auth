@page "/login"

@inject IAuthStateService AuthState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Login - Auth Manager</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex align-center justify-center" Style="min-height: 85vh;">
    <MudPaper Elevation="3" Class="pa-6" Style="width: 100%;">
        <MudStack Spacing="4">
            <MudStack Spacing="1" AlignItems="AlignItems.Center">
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" />
                </MudAvatar>
                <MudText Typo="Typo.h5" Align="Align.Center">Auth Manager</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                    Acesso exclusivo ao painel administrativo
                </MudText>
            </MudStack>

            <MudTextField @bind-Value="_email"
                          Label="Login (E-mail)"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Required="true"
                          RequiredError="O e-mail é obrigatório"
                          Disabled="@_loading"
                          Immediate="true"
                          @onkeydown="OnKeyDownAsync" />

            <MudTextField @bind-Value="_password"
                          Label="Senha"
                          Variant="Variant.Outlined"
                          InputType="@_passwordInputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@_passwordInputIcon"
                          OnAdornmentClick="TogglePasswordVisibility"
                          Required="true"
                          RequiredError="A senha é obrigatória"
                          Disabled="@_loading"
                          Immediate="true"
                          @onkeydown="OnKeyDownAsync" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="@_loading"
                       OnClick="EntrarAsync">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Entrando...</span>
                }
                else
                {
                    <span>Entrar</span>
                }
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private bool _loading;
    private bool _showPassword;

    private InputType _passwordInputType => _showPassword ? InputType.Text : InputType.Password;
    private string _passwordInputIcon => _showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        if (AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/", replace: true);
        }
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_loading)
        {
            await EntrarAsync();
        }
    }

    private async Task EntrarAsync()
    {
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            Snackbar.Add("Informe o login e a senha.", Severity.Warning);
            return;
        }

        _loading = true;
        try
        {
            var result = await AuthState.LoginAsync(_email, _password);
            if (result.Success)
            {
                Snackbar.Add("Login realizado com sucesso!", Severity.Success);
                Navigation.NavigateTo("/", replace: true);
                return;
            }

            foreach (var error in result.Errors ?? ["Credenciais inválidas."])
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        finally
        {
            _loading = false;
        }
    }
}
