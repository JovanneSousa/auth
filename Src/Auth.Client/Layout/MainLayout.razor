@inherits LayoutComponentBase
@implements IDisposable

@inject IAuthStateService AuthState
@inject NavigationManager Navigation
@inject IBrowserViewportService Viewport

<MudThemeProvider Theme="AuthTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" CloseOnEscapeKey="true" />
<MudSnackbarProvider />

@if (!AuthState.IsInitialized)
{
    <div class="auth-center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" aria-label="Carregando aplicação" />
    </div>
}
else if (IsLoginRoute)
{
    <main class="auth-login-bg">
        @Body
    </main>
}
else if (AuthState.IsAuthenticated)
{
    <MudLayout>
        <MudAppBar Elevation="0" Dense="true">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           aria-label="Abrir menu de navegação"
                           OnClick="() => _drawerOpen = !_drawerOpen" />
            <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Tertiary" Class="mr-2" />
            <MudText Typo="Typo.h6" Class="auth-brand">Auth Manager</MudText>
            <MudSpacer />
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <MudText Typo="Typo.body2" Class="mr-3 auth-user-email">@AuthState.UserEmail</MudText>
            </MudHidden>
            <MudTooltip Text="@($"Sair ({AuthState.UserEmail})")">
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit"
                               aria-label="Sair da aplicação" OnClick="SairAsync" />
            </MudTooltip>
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive"
                   Breakpoint="Breakpoint.Md" Elevation="0" ClipMode="DrawerClipMode.Always">
            <NavMenu />
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-3 pa-sm-6 auth-content">
                @Body
            </MudContainer>
            <Footer />
        </MudMainContent>
    </MudLayout>
}

@code {
    private bool _drawerOpen = true;

    private bool IsLoginRoute =>
        Navigation.ToBaseRelativePath(Navigation.Uri)
            .TrimStart('/')
            .StartsWith("login", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += HandleAuthStateChanged;
        Navigation.LocationChanged += HandleLocationChanged;
        await AuthState.InitializeAsync();
        EnforceAuthenticationRedirect();
    }

    protected override void OnParametersSet()
    {
        if (AuthState.IsInitialized)
        {
            EnforceAuthenticationRedirect();
        }
    }

    private async void HandleLocationChanged(object sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Mobile: recolhe o menu automaticamente ao navegar.
        var bp = await Viewport.GetCurrentBreakpointAsync();
        if (bp is Breakpoint.Xs or Breakpoint.Sm)
        {
            _drawerOpen = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void HandleAuthStateChanged()
    {
        EnforceAuthenticationRedirect();
        InvokeAsync(StateHasChanged);
    }

    private void EnforceAuthenticationRedirect()
    {
        if (!AuthState.IsAuthenticated && !IsLoginRoute)
        {
            Navigation.NavigateTo("/login", replace: true);
        }
        else if (AuthState.IsAuthenticated && IsLoginRoute)
        {
            Navigation.NavigateTo("/", replace: true);
        }
    }

    private async Task SairAsync()
    {
        await AuthState.LogoutAsync();
        Navigation.NavigateTo("/login", replace: true);
    }

    public void Dispose()
    {
        AuthState.OnChange -= HandleAuthStateChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
